{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mycelium-cmbse/mycelium-hypha/blob/development/knowledge/cross-references.schema.json",
  "title": "Hypha knowledge cross-references",
  "description": "Edges between the three knowledge trees: metamodel element -> spec clause identifier, BNF grammar production and worked example. Generated by tools/spec-extract. Records clause *identifiers* only and never clause text, so it is safe to commit while knowledge/spec stays git-ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersionUri",
    "documents",
    "provenanceTiers",
    "counts",
    "pilotDivergences",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "modelVersionUri": { "type": "string" },
    "documents": {
      "description": "Source specifications the clause identifiers refer to, keyed by tree name (kerml, sysml2).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "version"],
        "properties": {
          "document": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "provenanceTiers": {
      "description": "The four provenance tiers and what each means, so a consumer can explain them without hardcoding.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elements",
        "withClauses",
        "withoutClauses",
        "withGrammar",
        "withExamples",
        "clauseEdges",
        "grammarEdges",
        "exampleEdges"
      ],
      "properties": {
        "elements": { "type": "integer" },
        "withClauses": { "type": "integer" },
        "withoutClauses": { "type": "integer" },
        "withGrammar": { "type": "integer" },
        "withExamples": { "type": "integer" },
        "clauseEdges": { "type": "integer" },
        "grammarEdges": { "type": "integer" },
        "exampleEdges": { "type": "integer" }
      }
    },
    "pilotDivergences": {
      "description": "Curated PILOT-tier entries: points where the pilot implementation the XMI comes from diverges from the published specification. Not generated - added by hand after review.",
      "type": "array",
      "items": { "$ref": "#/$defs/pilotDivergence" }
    },
    "entries": {
      "description": "Keyed by element simple name; every element in knowledge/metamodel/index.json appears, with empty edge arrays where nothing matched.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "provenance": {
      "description": "Which tier a fact belongs to. NORMATIVE = verbatim clause-anchored spec text; MODEL = read from the XMI; DERIVED = computed or asserted here; PILOT = a pilot-implementation divergence.",
      "enum": ["NORMATIVE", "MODEL", "DERIVED", "PILOT"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element", "clauses", "grammar", "examples"],
      "properties": {
        "kind": { "enum": ["class", "enumeration", "primitiveType"] },
        "element": {
          "description": "Path to the element markdown, relative to knowledge/.",
          "type": "string"
        },
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/clauseEdge" } },
        "grammar": { "type": "array", "items": { "$ref": "#/$defs/grammarEdge" } },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/exampleEdge" } }
      }
    },
    "clauseEdge": {
      "description": "The element is treated in this clause. Carries the clause number only - never its title or body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "clause", "provenance", "method"],
      "properties": {
        "document": { "type": "string" },
        "clause": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "method": { "type": "string" }
      }
    },
    "grammarEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grammar", "production", "provenance", "method"],
      "properties": {
        "grammar": { "type": "string" },
        "production": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "method": { "type": "string" }
      }
    },
    "exampleEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "provenance", "method"],
      "properties": {
        "file": {
          "description": "Path to the worked example, relative to knowledge/.",
          "type": "string"
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "method": { "type": "string" }
      }
    },
    "pilotDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "summary", "provenance"],
      "properties": {
        "element": { "type": "string" },
        "summary": { "type": "string" },
        "clause": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
