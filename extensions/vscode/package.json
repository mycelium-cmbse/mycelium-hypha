{
  "name": "mycelium-hypha",
  "displayName": "Hypha – SysML v2 and KerML",
  "description": "Release-aware SysML v2 and KerML knowledge for GitHub Copilot in VS Code, through the hypha MCP server.",
  "version": "0.1.1",
  "publisher": "mycelium-cmbse",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mycelium-cmbse/mycelium-hypha"
  },
  "homepage": "https://github.com/mycelium-cmbse/mycelium-hypha",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "sysml",
    "sysml-v2",
    "kerml",
    "mbse"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mycelium-hypha.server",
        "label": "Hypha"
      }
    ]
  },
  "scripts": {
    "build:cli": "node ./scripts/build-cli.mjs",
    "package": "node ./scripts/package.mjs",
    "test:host": "node ./scripts/test-host.mjs",
    "compile": "tsc -p .",
    "test": "node ./scripts/clean-output.mjs && tsc -p . && node --test out/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    }
  }
}
