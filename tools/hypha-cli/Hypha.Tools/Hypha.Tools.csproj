<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hypha.Tools</RootNamespace>
    <AssemblyName>hypha</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Version>1.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <PackageId>Hypha.Tools</PackageId>
    <ToolCommandName>hypha</ToolCommandName>
    <Title>hypha</Title>
    <Description>
      Fetches the upstream OMG SysML v2 / KerML sources and generates the hypha knowledge base from
      them.
    </Description>
    <PackageTags>SysML KerML OMG MBSE knowledge-base</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Starion Group S.A.</Authors>
    <Company>Starion Group S.A.</Company>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <!-- Self-contained publishing is the no-SDK delivery. NativeAOT is deliberately not attempted:
         Handlebars.Net compiles templates at runtime through expression trees, and uml4net is
         reflection-heavy over XMI. Trimming carries a milder version of the same risk, so it is left
         off here and treated as an optimisation to verify rather than assume. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates an SBOM for the shipped tool as part of build/pack (see release.yml). -->
    <PackageReference Include="Microsoft.Sbom.Targets">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Microsoft.Sbom.Targets only wires itself into `Pack` (embedding the manifest in the .nupkg).
       The self-contained per-RID builds in release.yml use `publish` instead, so this reruns the same
       task against $(PublishDir) - reusing the package's own SbomGeneration* defaults (package name,
       version, supplier) rather than recomputing them. -->
  <Target Name="GenerateSbomForPublish" AfterTargets="Publish" Condition="'$(GenerateSBOM)' == 'true'">
    <GenerateSbom
        BuildDropPath="$(PublishDir)"
        BuildComponentPath="$(SbomGenerationBuildComponentPath)"
        PackageSupplier="$(SbomGenerationPackageSupplier)"
        PackageName="$(SbomGenerationPackageName)"
        PackageVersion="$(SbomGenerationPackageVersion)"
        NamespaceBaseUri="$(SbomGenerationNamespaceBaseUri)"
        NamespaceUriUniquePart="$(SbomGenerationNamespaceUriUniquePart)"
        FetchLicenseInformation="$(SbomGenerationFetchLicenseInformation)"
        EnablePackageMetadataParsing="$(SbomGenerationEnablePackageMetadataParsing)"
        Verbosity="$(SbomGenerationVerbosity)"
        ManifestInfo="$(SbomGenerationManifestInfo)"
        DeleteManifestDirIfPresent="$(SbomGenerationDeleteManifestDirIfPresent)"
        SbomToolPath="$(SbomToolPath)"
        ContinueOnError="ErrorAndContinue" />
  </Target>

  <ItemGroup>
    <!-- So the tests can parse against the command line the tool actually exposes, rather than a
         rebuilt approximation of it. -->
    <InternalsVisibleTo Include="Hypha.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\knowledge-gen\Hypha.Knowledge\Hypha.Knowledge.csproj" />
    <ProjectReference Include="..\..\metamodel-gen\Hypha.MetamodelGen\Hypha.MetamodelGen.csproj" />
  </ItemGroup>

</Project>
