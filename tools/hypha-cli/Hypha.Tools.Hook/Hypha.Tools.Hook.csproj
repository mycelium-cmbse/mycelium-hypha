<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hypha.Tools.Hook</RootNamespace>
    <AssemblyName>hypha-hook</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Assembly">
    <!-- Not a package of its own: hook-binaries.yml publishes it with NativeAOT into hooks/native/. -->
    <IsPackable>false</IsPackable>
    <Description>
      The SessionStart hook of the hypha Claude plugin: it checks the locally installed releases and
      downloads and launches the hypha CLI.
    </Description>
    <Authors>Starion Group S.A.</Authors>
    <Company>Starion Group S.A.</Company>
    <Copyright>Copyright 2026 Starion Group S.A.</Copyright>
    <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-hypha</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <!-- The one hypha-cli project that IS NativeAOT-published: it never generates anything itself,
         only downloads and launches the real `hypha` CLI, so it carries none of the reflection-heavy
         dependencies (Handlebars.Net, uml4net) that keep Hypha.Tools off AOT. That is what makes it
         small enough to commit into the plugin repository per platform (see hooks/native/). Deliberately
         has NO ProjectReference to Hypha.Tools or Hypha.Knowledge: pulling either in would drag their
         non-AOT-safe dependency graph into this build. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- The download and verification of the hypha CLI is the launcher's (tools/hypha-cli/Hypha.Launcher);
         the hook compiles the same sources until it is retired (Step 8 of hypha-mcp-refactor-plan.md),
         rather than reference the launcher, which is an executable of its own. -->
    <Compile Include="..\Hypha.Launcher\Provisioning\*.cs" Link="Provisioning\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the tests can exercise the pure functions (checksum parsing, status summarisation, cache
         path resolution, lock staleness) directly. -->
    <InternalsVisibleTo Include="Hypha.Tools.Hook.Tests" />
  </ItemGroup>

</Project>
