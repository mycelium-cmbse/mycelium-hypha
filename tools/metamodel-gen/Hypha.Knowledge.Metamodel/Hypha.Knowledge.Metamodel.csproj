<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hypha.Knowledge.Metamodel</RootNamespace>
    <AssemblyName>Hypha.Knowledge.Metamodel</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Assembly">
    <!-- Not a package of its own: the Hypha.Tools package carries it. -->
    <IsPackable>false</IsPackable>
    <Description>
      Generates the metamodel knowledge of a SysML v2 / KerML release, and the Systems Modeling API
      PIM, from their XMI: one page per metaclass, enumeration and primitive type, and an index.
    </Description>
    <Authors>Starion Group S.A.</Authors>
    <Company>Starion Group S.A.</Company>
    <Copyright>Copyright 2026 Starion Group S.A.</Copyright>
    <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-hypha</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Handlebars.Net" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="uml4net.Extensions" />
    <PackageReference Include="uml4net.xmi" />
  </ItemGroup>

  <ItemGroup>
    <!-- For IKnowledgeGenerator and IKnowledgeLayout, and the metamodel contracts this writes. The
         dependency runs this way only: the knowledge library knows nothing about uml4net or
         Handlebars. -->
    <ProjectReference Include="..\..\knowledge-gen\Hypha.Knowledge\Hypha.Knowledge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*.hbs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
